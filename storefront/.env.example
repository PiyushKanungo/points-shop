# Copy to .env.local for local development. Never commit real secrets.

# stub = built-in fake API (no Salesforce needed); salesforce = the real org
SHOP_BACKEND=stub
# Public URL of the site (links in emails, Origin check). On Vercel previews the branch URL is used automatically.
SITE_URL=http://localhost:3000

# Random strings of 32+ characters each, e.g. `node -e "console.log(crypto.randomBytes(32).toString('hex'))"`
SESSION_SECRET=
MAGIC_LINK_SECRET=

# Email. Without RESEND_API_KEY, emails are written to .local-email/ instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=Points Shop <onboarding@resend.dev>
OWNER_EMAIL=you@example.com

# Cloudflare Turnstile. These are Cloudflare's public test keys (always pass); use real keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Salesforce (only when SHOP_BACKEND=salesforce): My Domain URL and External Client App credentials
SF_LOGIN_URL=https://your-domain.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

# Optional links in the footer
BMAC_URL=
GITHUB_URL=
LINKEDIN_URL=

# Local testing only: catalog = catalogue fails, all = every API call fails (stub backend)
STUB_FAIL=
