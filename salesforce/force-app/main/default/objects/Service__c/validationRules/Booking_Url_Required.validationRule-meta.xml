<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Booking_Url_Required</fullName>
    <active>false</active>
    <errorConditionFormula>ISPICKVAL(Fulfilment_Type__c, 'Booking') &amp;&amp; ISBLANK(Booking_Url__c)</errorConditionFormula>
    <errorMessage>Booking offerings need a booking URL.</errorMessage>
</ValidationRule>
