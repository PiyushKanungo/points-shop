<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
  <fullName>Review_Only_When_Delivered</fullName>
  <active>true</active>
  <errorConditionFormula>
    (ISCHANGED(Review_Rating__c) || ISCHANGED(Review_Text__c)) &amp; &amp; NOT(ISPICKVAL(Status__c, 'Delivered'))
  </errorConditionFormula>
  <errorMessage>Reviews can be added only to delivered orders.</errorMessage>
</ValidationRule>
