<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Terminal_Status_Locked</fullName>
    <active>true</active>
    <errorConditionFormula>ISCHANGED(Status__c) &amp;&amp;
(ISPICKVAL(PRIORVALUE(Status__c), 'Delivered') ||
ISPICKVAL(PRIORVALUE(Status__c), 'Cancelled'))</errorConditionFormula>
    <errorMessage>Delivered and cancelled orders cannot change status.</errorMessage>
</ValidationRule>
