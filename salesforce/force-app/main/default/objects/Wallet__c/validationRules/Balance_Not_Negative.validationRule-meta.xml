<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Balance_Not_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>Balance__c &lt; 0</errorConditionFormula>
    <errorMessage>INSUFFICIENT_POINTS: balance cannot go below zero.</errorMessage>
</ValidationRule>
